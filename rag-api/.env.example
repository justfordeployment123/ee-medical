# OpenAI (required for RAG)
OPENAI_API_KEY=your_openai_api_key

# Admin panel credentials
ADMIN_USER=admin
ADMIN_PASS=your_secure_password

# Email / SMTP — required for enquiry form + lead emails
# Without these, form submissions are only logged to console.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@eemedicals.com
EMAIL_TO=info@eemedicals.com, eyong.ebot@eemedicals.com
